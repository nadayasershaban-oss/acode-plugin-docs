import tkinter as tk
import time
TOTAL_DURATION = 16.0
lyrics = [(0.0, 'أغيب واقول ده زمانه نسيني'),
(4.0, 'ماهو لو ينسي هينسيني'),
(9.0, 'طول ما هو فاكر هفضل فاكر'),
(12.0, 'ايوه أمال انا بسأل ليه')]
class SimpleKaraoke:
def init(self, root):
self.root = root
self.root.title("amr diab")
self.root.geometry("900x520")
self.root.configure(bg="black")
self.start_time = time.time()
self.current_time = 0.0
self.label = tk.Label(
root, text="", font=("Arial", 32, "bold"),
fg="white", bg="black", wraplength=860, justify="center"
)
self.label.pack(expand=True, fill="both", padx=16, pady=16)
self.update_display()
def update_display(self):
self.current_time = time.time() - self.start_time
if self.current_time >= TOTAL_DURATION:
self.current_time = TOTAL_DURATION
current_line = ""
for t, text in lyrics:
if self.current_time >= t:
current_line = text
self.label.config(text=current_line)
if self.current_time < TOTAL_DURATION:
